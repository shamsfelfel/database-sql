[Unit]
Description=Unattended build of the database-design theory track
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/work/shams/database-sql
Environment=THEORY_MODEL=opus
ExecStart=/usr/bin/python3 tools/theory_runner.py
# The runner is resumable: it skips every page whose source already exists, so a
# restart costs at most the page that was in flight.
Restart=always
RestartSec=60
# One page at a time, politely: this box runs other people's work too.
Nice=10

[Install]
WantedBy=default.target
